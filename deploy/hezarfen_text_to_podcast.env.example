# SUNUCU ayar dosyasi iskeleti — hezarfen_text_to_podcast.env
#
# Hedef: ~/hezarfen_text_to_podcast/hezarfen_text_to_podcast.env   (chmod 0600)
# Bu dosyayi deploy ASLA olusturmaz/ezmez; yoksa deploy NEDENIYLE birlikte
# reddeder. Kopyalama:
#
#   ssh <sunucu>
#   mkdir -p ~/hezarfen_text_to_podcast
#   cp <repo>/deploy/hezarfen_text_to_podcast.env.example \
#      ~/hezarfen_text_to_podcast/hezarfen_text_to_podcast.env
#   chmod 0600 ~/hezarfen_text_to_podcast/hezarfen_text_to_podcast.env
#
# ANAHTARLARIN TAM LISTESI BURADA DEGIL: depo kokundeki `.env.example` tum
# ~45 anahtari tek tek aciklar. Iki liste iki dogruluk kaynagi olurdu, o yuzden
# burasi yalniz SUNUCUYA OZGU olanlari ve varsayilanla yetinilebileceklerini
# soyler.
#
# BURAYA GERCEK SIR YAZMA; bu dosya depoda IZLENIR. Gercek deger yukaridaki
# hedef dosyaya girer (o dosya sunucuda kalir, .gitignore disidir).
#
# --- SUNUCUDA DEGISTIRILMESI ZORUNLU -----------------------------------------

# Backend ile AYNI olmali. Eksikse compose modeli cozulmez
# (`${AI_SHARED_TOKEN:?...}`) ve deploy konteynere dokunmadan reddeder.
AI_SHARED_TOKEN=change-me

# --- SUNUCUDA GOZDEN GECIR (varsayilan cogu zaman DOGRU) ----------------------

# Kopru backend'e compose agi uzerinden dial-out eder; ad backend'in compose
# agindaki servis adidir.
AI_BRIDGE_HOST=hezarfen_backend
AI_BRIDGE_PORT=8090
AI_BACKEND_URL=http://hezarfen_backend:7656
AI_TLS_SERVER_NAME=localhost
AI_SERVICE_NAME=podcast

# Gercek hat mi. `simulate` YALNIZ gelistirme icindir ve acilista
# "uretilen ses GERCEK DEGIL" uyarisi basar. Sunucuda `real` olmali:
# imajda hat var, agirliklar podcast-models hacminde.
PODCAST_MODE=real
PODCAST_PIPELINE_PATH=/app/pipeline

# Gercek is ~45 dakika surer; backend'e bildirilen tahmin. 0 = OTOMATIK
# (SAHTE hattin suresini hesaplar) — `real` modda YANLIS olur.
PODCAST_ETA_SECS=2700

# Agirliklar hacimde; HF'e AG CAGRISI YOK. Eksik agirlik ACIK hata verir.
HF_HUB_OFFLINE=1

# Backend'in compose kaynaklari (external adlar). Proje adi dizin adindan
# turedigi icin sunucudaki gercek adlari once dogrula:
#   podman volume ls | podman network ls
HEZARFEN_NET=hezarfen_backend_default
HEZARFEN_DATA_VOLUME=hezarfen_backend_hezarfen-data

# --- ISTEGE BAGLI -------------------------------------------------------------

# DeepSeek anahtari. TANIMSIZ BIRAKILABILIR: yoklugu boot'u cokertmez, yalnizca
# `tek_ogretici`/`ogrenci_hoca` formatlarini kapatir (`duz_okuma` acik kalir).
# DEEPSEEK_API_KEY=

# Is durumu ve uretilen ses ~30 gun sonra silinsin (0 = asla silme).
PODCAST_RETENTION_DAYS=30
