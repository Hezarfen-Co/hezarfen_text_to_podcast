# systemd KULLANICI unit'i: podcast koprusunu podman compose ile calistirir.
# %h/hezarfen_text_to_podcast icinde beklenen dosyalar:
#   compose.yaml                     bu repodan (deploy artefaktindan)
#   hezarfen_text_to_podcast.env     0600, ELLE yazilir; deploy OLUSTURMAZ/EZMEZ.
#                                    Operatorun SIRLARINI tasir:
#                                    AI_SHARED_TOKEN, ELEVENLABS_API_KEY,
#                                    ELEVENLABS_VOICE_ID, LLM_API_KEY, ...
#                                    iskelet: deploy/hezarfen_text_to_podcast.env.example
#   stack.env                        deploy sahipli; HEZARFEN_TAG (imaj etiketi)
#
# IKI `--env-file` YASAK. podman-compose 1.6.0 `--env-file`i TEK DEGER sayar
# (podman_compose.py:2941-2946) ve verildiginde YALNIZCA SONUNCUSUNU okur: iki
# bayrak operator ayar dosyasini sessizce dusurur, `${AI_SHARED_TOKEN:?}` de
# "required variable is missing a value" ile reddeder (zeka deploy'u bu yuzden
# dustu). Bu yuzden operator dosyasi systemd `EnvironmentFile=` ile PROCESS
# ORTAMINA alinir; compose'a YALNIZCA stack.env verilir.
#
# Unit `--no-build` ile baslar, yani imaj sunucuda zaten olmali:
#   podman compose --profile product build     # burada derle
#   podman load -i image.tar                   # ya da hazir imaji yukle
#
# Once TAM BIR KEC:  loginctl enable-linger <kullanici>
#
# Ortam degiskeni degistiginde: systemctl --user restart hezarfen_text_to_podcast_compose

[Unit]
Description=Hezarfen podcast bridge (text-to-podcast, hab/2 dial-out)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/hezarfen_text_to_podcast
EnvironmentFile=%h/hezarfen_text_to_podcast/hezarfen_text_to_podcast.env
ExecStart=/usr/bin/podman compose --profile product --env-file %h/hezarfen_text_to_podcast/stack.env up -d --no-build
ExecStop=/usr/bin/podman compose --profile product --env-file %h/hezarfen_text_to_podcast/stack.env down
TimeoutStartSec=300

[Install]
WantedBy=default.target
