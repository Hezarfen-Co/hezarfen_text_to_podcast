# hezarfen_podcast_service ortam degiskenleri — ORNEK DOSYA
#
# Kullanim:  cp .env.example .env  ve degerleri doldur.
# `.env` .gitignore'dadir; BU dosya (.env.example) kasten izlenir.
# BURAYA GERCEK SIR YAZMA. Hepsi yer tutucudur.
#
# Genel kural (backend ile ayni): YANLIS yapilandirma boot'u cokertir (exit 2),
# EKSIK yapilandirma yalnizca ilgili ozelligi sessizce kapatir.

# --- Kopru / QUIC ------------------------------------------------------------

# Backend'in QUIC dinleyicisinin adresi. Servis PORT ACMAZ; buraya dial-out eder.
# Compose agindaki KONTEYNER adi kullanilir ki NAT/host farki sorun olmasin.
# Ad backend'in compose'undan gelir: `container_name: hezarfen_backend`
# (alt cizgi — 2026-09-14'te tireli adlar alt cizgiye cevrildi).
AI_BRIDGE_HOST=hezarfen_backend
AI_BRIDGE_PORT=8090

# Sertifikayi cekmek icin backend'in HTTP koku. Backend self-signed sertifikayi
# her acilista uretebildigi icin PEM her yeniden baglanmada tekrar cekilir.
# Port backend'in KENDI HTTP portudur (Containerfile PORT=7656); hostta
# 127.0.0.1:7656'ya publish edilir, konteynerden konteynere 7656'dir.
AI_BACKEND_URL=http://hezarfen_backend:7656

# Backend ile paylasilan sir. ZORUNLU: yoksa kopru acilista exit 2 verir —
# cunku kaydin kimlik dogrulamasi budur ve sirsiz kayit sessizce reddedilir,
# yani "eksik" degil "yanlis" yapilandirmadir.
# ASLA gercek degerini bu dosyaya yazma; `.env` icine koy.
AI_SHARED_TOKEN=change-me

# Sertifikanin SAN'i. Backend'in urettigi sertifika `localhost` icin gecerli.
AI_TLS_SERVER_NAME=localhost

# Hello cercevesinde bildirilecek servis adi. Backend yetenekleri bu ada baglar.
AI_SERVICE_NAME=podcast

# Ayni anda islenen hab/2 istek sayisi; asilirsa istege `busy` donulur.
# Bu ISTEK esiktir, IS esigi degil — istekler milisaniyeliktir (bkz. PODCAST_MAX_JOBS).
AI_MAX_CONCURRENT=2

# Baglanti koptugunda ilk yeniden deneme araligi (saniye). Her basarisiz
# denemede ikiye katlanir, jitter eklenir ve AI_RECONNECT_MAX_SECS'te durur.
# Kalici bir red (unauthorized / unsupported_protocol) donguden CIKMAZ; tavan
# bekleme ile yeniden denenir, boylece backend duzelince servis toparlanir.
AI_RECONNECT_SECS=3

# Geri cekilmenin tavani (saniye).
AI_RECONNECT_MAX_SECS=120

# Backend'in bildirdigi sertifika parmak izi (SHA-256 hex, iki nokta ayraclari
# atilir). BOS = TOFU: gelen PEM'e dogrulama yapilmadan guvenilir. Doldurulursa
# PEM'den DER cikarilip SHA-256'si KENDIMIZ hesaplanir; uyusmazsa baglanilmaz.
AI_TLS_FINGERPRINT=

# debug / info / warn / error. Gecersiz deger boot'u cokertir.
LOG_LEVEL=info

# --- Podcast is kuyrugu ------------------------------------------------------

# Is durumunun tutuldugu dizin: is basina bir JSON dosyasi, atomik yazilir
# (gecici dosya + os.replace). Servis yeniden baslarsa durum kaybolmasin diye
# DISKTE tutulur ve compose'ta adlandirilmis bir hacme baglanir.
PODCAST_JOB_ROOT=/data/podcast/jobs

# Ayni anda kosan UZUN is sayisi. Uzun isler kendi daemon isci thread'lerinde
# kosar (kuyruk + sentinel ile kapanir); hizli yetenek cagrilari
# (submit/status/result/cancel) o havuza HIC girmez — yoksa 45 dakikalik bir is,
# backend'in 60 saniyelik istek deadline'ini yerdi.
# Thread'ler DAEMON'dur: SIGTERM geldiginde surec, kosan is bitmeden cikabilsin
# diye. ThreadPoolExecutor bunu yapamiyordu (olculdu: 8 sn'lik iste 8 sn takilma).
PODCAST_WORKERS=1

# Kuyruk + kosan islerin toplam tavani. Asilirsa `podcast.submit` -> `busy`.
PODCAST_MAX_JOBS=8

# SAHTE hattaki her asama arasinda beklenen sure (saniye). Gercek hat henuz
# bagli degil; ocr -> plan -> script -> tts -> mux asamalari taklit ediliyor.
# Kucuk tutulmasinin sebebi: yasam dongusu 45 dakika beklemeden kanitlanabilsin.
# Gercek hat baglaninca bu degisken anlamini yitirecek.
PODCAST_STAGE_SECS=0.2

# Bir isin tahmini toplam suresi (saniye); backend'e `eta_secs` olarak bildirilir.
# 0 = OTOMATIK: asama sayisi * PODCAST_STAGE_SECS (en az 1 sn) kullanilir.
# Gerekce: otomatik hesap SAHTE hattin suresidir. Gercek hat baglaninca burasi
# ayarlanmazsa backend'e 45 dakikalik bir is icin "1 saniye" denir. Gercek hat
# icin 2700 gibi bir deger yaz. Aralik 0..86400; disina cikan deger boot'u cokertir.
# `real` modda ve burasi verilmemisse OTOMATIK deger 2700 (45 dk) kullanilir -
# olculen gercek suredir. `simulate` modda otomatik deger eskisi gibi asama
# sayisi * PODCAST_STAGE_SECS'tir.
PODCAST_ETA_SECS=0

# Kaynak dosyanin cozulecegi paylasilan kok dizin: <kok>/<okul-slug>/<source_key>.
# Backend'in FILES_PATH degeriyle AYNI olmali. Okul slug'i [a-z0-9-] (en fazla 64
# karakter), source_key [A-Za-z0-9._-] ve en fazla 128 karakter olabilir; cozulen
# yolun bu kokun ALTINDA kaldigi ayrica dogrulanir (symlink kacisi icin). Adim 4'te
# compose'a baglandi: backend'in `hezarfen-data` hacmi buraya SALT-OKUNUR (:ro)
# monte edilir. Servis PDF'e yalnizca okur.
PODCAST_MEDIA_ROOT=/data/files

# --- Motor secimi ------------------------------------------------------------

# SAHTE mi GERCEK mi. `simulate` | `real`. Gecersiz deger boot'u cokertir.
#   simulate : `jobs.py::_simulate_pipeline` kosar. Acilista TEK SATIR uyari
#              basilir: "SAHTE hat kosuyor, uretilen ses GERCEK DEGIL".
#              Uretilen kimlikler `sim_` onekli olur.
#   real     : secilen motora (PODCAST_ENGINE) gore gercek is kosar.
#              SESSIZ SAHTE URETIM YOK.
# compose VARSAYILANI `real`'dir. Elle `python -m src.bridge` kosarken
# varsayilan hala `simulate`tir.
PODCAST_MODE=real

# Gercek isi hangi motor kosar. `api` (VARSAYILAN) | `local`. Gecersiz deger
# boot'u cokertir.
#
#   api   : YERLI hat, hicbir vendor agaci gerektirmez:
#             PDF -> PyMuPDF metin cikarma (+ gerekirse tesseract OCR)
#                 -> script (LLM ile yeniden yazim; `duz_okuma` LLM'siz)
#                 -> ElevenLabs HTTP TTS
#                 -> ffmpeg ile tek mp3'e birlestirme (mux)
#           GEREKEN ANAHTARLAR: ELEVENLABS_API_KEY + ELEVENLABS_VOICE_ID
#           (bulut TTS her is icin sart). LLM_* yalnizca `tek_ogretici` /
#           `ogrenci_hoca` formatlari icin gerekir; `duz_okuma` anahtarsiz kosar.
#           Eksik anahtar boot'u COKERTMEZ: is, tts/llm asamasinda NET bir hata
#           koduyla `failed` olur (sahte ses URETILMEZ).
#
#   local : bugunku vendored Hat yolu (`router.hat`). vendor/pipeline GEREKIR;
#           agac yoksa `PODCAST_MODE=real` + bu motor CALISMA ANINDA exit 2 ile
#           acik hata verir (build degil). Kendi agir bagimliliklarini
#           (torch/transformers/easyocr) ve PODCAST_TTS_ENGINE/SES_BULUT_IZINLI
#           anahtarlarini kullanir.
PODCAST_ENGINE=api

# Yalnizca `local` motor icin: hat kaynagi kokunun mutlak yolu (icinde
# `router/hat.py` bulunan dizin). `simulate` modda ve `api` motorunda hic
# okunmaz. CONTAINER'DA: /app/pipeline (Containerfile `vendor/`i kosullu
# kopyalar). YERELDE (tools/smoke_test.py): C:\PROJECTS\podcast
PODCAST_PIPELINE_PATH=/app/pipeline

# `Hat(cikti_koku=...)` - uretilen mp3/script/quiz dosyalarinin kok dizini.
# Container'da uid 10001 sahipliginde olusturulur; kalici hacme baglanmali,
# yoksa uretilen ses container ile birlikte silinir.
PODCAST_OUTPUT_ROOT=/data/podcast/out

# Bolum tavani. 1 = yalnizca ilk bolum (en hizli, varsayilan); 0 veya -1 =
# HEPSI. Birden fazla bolum uretilirse yerel kayitta `audio_id`/`script_id` ILK
# bolumu gosterir, `audio_ids`/`script_ids` HEPSINI; backend'e yuklenen ses
# bunlarin ffmpeg ile birlestirilmis tek mp3'udur.
PODCAST_CHAPTER_LIMIT=1

# `Hat(motor_adi=...)` - YALNIZCA `local` motorun TTS motoru; asagidaki
# TTS bolumunde ayrintili. `api` motoru bu anahtari OKUMAZ.
# `router.kayit.Kayit` defteri (SQLite): adim onbellegi, resume kayitlari ve LLM
# butce sayaci burada durur. ONBELLEK BU HATTIN TASARIM ILKESIDIR - defter kalici
# degilse her kosu her adimi bastan yapar (olculen script adimi tek basina ~34 dk).
# Bu yuzden compose'ta AYRI bir hacme (`podcast-kayit`) baglanir.
PODCAST_LEDGER_DB=/data/podcast/kayit/router.sqlite

# --- Model agirliklari (adim 4) ----------------------------------------------

# HuggingFace ve torch onbellek kokleri. `podcast-models` hacmi buraya SALT-OKUNUR
# baglanir; agirliklar IMAJA GIRMEZ (~3,9 GB olculdu). Hacmi doldurmak:
#   pwsh -File deploy/setup-models.ps1
HF_HOME=/models/hf
TORCH_HOME=/models/torch

# 1 = HF hub'a AG CAGRISI YAPILMAZ. Agirlik hacimde yoksa hat ACIK hata verir;
# sessizce 2,2 GB indirmeye baslamaz (uretimde istenmeyen davranis). Ilk kez
# doldururken gecici olarak 0 yapilabilir.
HF_HUB_OFFLINE=1

# NOT: hattin TTS ve ASR agirliklari HF onbelleginde DEGIL, `ses/ayar.py` icinde
# SABIT KODLU `<hat_koku>/data/ses_modelleri` altindadir. Containerfile o yolu
# /models/ses_modelleri'ne sembolik bagla baglar; ayri bir degisken YOKTUR
# (kaynak dogrulandi: ses/ayar.py:26 MODEL_KOKU, :186 ASR_KOK).

# --- Lokal motorun bagimlilik hacmi (yalnizca PODCAST_ENGINE=local) -----------

# Agir bagimliliklar (torch/transformers/easyocr/onnxruntime) ve TTS/ASR
# agirliklari IMAJA GIRMEZ; bu hacimde dururlar. Kurulum tek komut ve imaji
# DEGISTIRMEZ (workflow kosmaz):
#
#   bash deploy/setup-local-engine.sh            # varsayilan: podcast-models
#
# Betik ayni IMAJI calistirir ve tekerlekleri /models/local-venv icine kurar;
# boylece derlenmis tekerlekler runtime Python ABI'siyle uyusur.
#
# DURUST SINIR: lokal motorun KENDI kaynagi (vendored `router/hat.py` agaci)
# hicbir repoda YOK; bu hacim onu getirmez. `local` secilebilir ama kaynak
# geri gelmedikce KOSULAMAZ (acilista isimli hata + kurulum komutu).
PODCAST_LOCAL_VENV=/models/local-venv

# --- Backend'in compose kaynaklari (external) --------------------------------

# Podcast compose'u backend'in AGINA baglanir ve backend'in DOSYA HACMINI :ro
# monte eder. Ikisinin de adi backend'in COMPOSE PROJE ADINDAN turer
# (`<proje>_default`, `<proje>_hezarfen-data`) ve proje adi varsayilan olarak
# DIZIN ADIDIR. Bu makinede backend dizini `hezarfen_backend-main`, ama
# frontend ve chatbot compose'lari agi `hezarfen_backend_default` diye SABIT
# yaziyor; bu yuzden `deploy/run-stack.ps1` backend'i BILEREK
# `-p hezarfen_backend` ile kaldirir ve asagidaki varsayilanlar tutar.
# Betik ayrica gercek adlari `podman inspect hezarfen-backend`ten OKUR ve
# bu degiskenleri kendisi ayarlar. Elle `podman compose up` yapiyorsan
# ONCE DOGRULA:  podman volume ls  |  podman network ls
HEZARFEN_NET=hezarfen_backend_default
HEZARFEN_DATA_VOLUME=hezarfen_backend_hezarfen-data

# --- LLM (api motoru; istege bagli) -------------------------------------------

# OpenAI-UYUMLU her uc nokta bu ucluyle takilir; saglayici degistirmek icin KOD
# DEGISMEZ (filo sozlesmesi, hezarfen_rag/hezarfen_zeka ile ayni adlar):
#   LLM_BASE_URL  taban adres (varsayilan https://api.deepseek.com)
#   LLM_MODEL     model id  (varsayilan deepseek-chat)
#   LLM_API_KEY   saglayicinin anahtari
# Ornek baska saglayici:
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=moonshotai/kimi-k3
#   LLM_API_KEY=<nvapi-...>
#
# LLM_API_KEY TANIMSIZ BIRAKILABILIR — yoklugu boot'u COKERTMEZ,
# yalnizca LLM isteyen formatlari kapatir:
#   duz_okuma     -> anahtarsiz da sonuna kadar kosar (varsayilan format)
#   tek_ogretici  -> anahtar ister; anahtarsiz submit -> err `llm_unavailable`
#   ogrenci_hoca  -> anahtar ister; anahtarsiz submit -> err `llm_unavailable`
# Acilista tek satir log hangi formatlarin acik oldugunu yazar.
# Anahtarin KENDISI hicbir yerde loglanmaz, hata mesajina girmez, diske yazilmaz;
# yalnizca "tanimli / TANIMSIZ" bilgisi gorunur.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-buraya-gercek-anahtar-YAZMA
# Reasoning modelleri max_tokens'i dusunmeye harcayip bos icerik dondurebiliyor;
# saglayiciya ozgu govde parametresi buraya JSON olarak yazilir:
#   LLM_EXTRA_JSON={"reasoning_effort": "none"}
LLM_EXTRA_JSON=
# Tek cagri zaman asimi (saniye) ve 429/5xx/timeout icin yeniden deneme.
LLM_TIMEOUT_S=30
LLM_MAX_ATTEMPTS=3

# Bitmis (done/failed/cancelled) isleri ve URETTIKLERI ses/script dosyalarini
# kac gun sonra sil. 0 = asla silme (kod varsayilani; veri silmek opt-in).
# Acilista bir kez calisir. Kuyruktaki ve KOSAN isler yasina bakilmadan
# korunur. Silinecek yollar cikti kokunun ALTINDA olmak zorundadir; disari
# isaret eden bir kimlik uyari loglanip ATLANIR.
PODCAST_RETENTION_DAYS=30

# --- TTS: api motoru (ElevenLabs bulut) ---------------------------------------

# api motorunun TTS'i her zaman buluttadir ve bu uc anahtarla calisir.
# ELEVENLABS_API_KEY ve ELEVENLABS_VOICE_ID ZORUNLUDUR: biri yoksa her is
# `tts_key_missing` / `tts_voice_missing` koduyla `failed` olur (sessizce
# lokale DUSMEZ, sahte ses uretilmez).
# ELEVENLABS_API_KEY=buraya-gercek-anahtar-YAZMA

# Kullanilacak sesin kimligi (ElevenLabs panelinden): zorunlu.
ELEVENLABS_VOICE_ID=

# Uc nokta ve model. Varsayilan model, lokal hattin kilitledigi modelin
# aynisidir (eleven_flash_v2_5 + language_code=tr).
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL=eleven_flash_v2_5

# language_code; flash modelleri bunu alir. Turkce icerik icin `tr`.
ELEVENLABS_LANGUAGE=tr

# Cikti bicimi. OLCULDU: pcm_44100 "Pro tier and above" deyip HTTP 403 verir.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# ElevenLabs istek zaman asimi (saniye).
ELEVENLABS_TIMEOUT_S=120

# --- TTS: local motor (ONNX) ---------------------------------------------------

# Hangi TTS motoru kosacak.
#   supertonic-3        -> LOKAL, ag yok, agirlik podcast-models hacminden gelir
#   elevenlabs-flash-tr -> BULUT, ag sart, agirlik YOK, ucret saglayicida sayilir
# Bilinmeyen ad verilirse hat acik hata verir; sessizce lokale DUSMEZ.
PODCAST_TTS_ENGINE=supertonic-3

# Bulut TTS kapisi. 1/true/evet acar. Varsayilan KAPALI.
# Kapaliyken elevenlabs-flash-tr cagrilirsa `BulutYasak` firlatir - bu
# KASITLIDIR: anahtar unutuldugunda is sessizce lokal sesle bitmesin,
# ACIK hata versin diye. Iki bayrak birden gerekir (motor adi + bu izin).
SES_BULUT_IZINLI=0

# ElevenLabs anahtari. TANIMSIZ BIRAKILABILIR - yoklugu boot'u COKERTMEZ,
# yalnizca bulut motoru yuklenemez (`MotorYuklenemedi`).
# Anahtarin KENDISI loglanmaz, SesParcasi.ek sozluguna girmez, diske yazilmaz.
# ELEVENLABS_API_KEY=buraya-gercek-anahtar-YAZMA

# Kullanilacak sesin kimligi. BOS birakilirsa adaptordeki hazir ses kullanilir.
# Anahtarda `voices_read` izni yoksa API'den ses listesi CEKILEMEZ; kimlik
# ElevenLabs panelinden elle alinip buraya yazilir.
ELEVENLABS_VOICE_ID=

# KILITLI KONFIGURASYON (ses/ayar.py icinde, burada degistirilmez):
#   model      = eleven_flash_v2_5   (kullanici 2026-09-16'da dinleyip secti)
#   dil        = tr                  (language_code; flash bunu alir,
#                                     multilingual_v2 ALMAZ - otomatik algilar)
#   kararlilik = 0.85 / benzerlik 0.85 / stil 0.0  (ders anlatimi: bolumler
#                                     arasi ton kaymasin diye yuksek kararlilik)
#   cikti      = mp3_44100_128 -> ffmpeg ile WAV'a cevrilir.
#                OLCULDU: pcm_44100 "Pro tier and above" diyip HTTP 403 verdi.
